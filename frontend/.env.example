VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Or use the newer publishable key variable:
# VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
VITE_DEV_MEMBER_ID=1

# Optional. If omitted, the app derives it from VITE_SUPABASE_URL:
# https://your-project-ref.functions.supabase.co
VITE_SUPABASE_FUNCTIONS_URL=https://your-project-ref.functions.supabase.co

# Optional direct overrides.
# VITE_KAKAO_READY_URL=https://your-project-ref.functions.supabase.co/kakao-ready
# VITE_KAKAO_APPROVE_URL=https://your-project-ref.functions.supabase.co/kakao-approve
